;
; default_8x8.inc — шрифт 8x8 по умолчанию для Вектора-06Ц.
;
; Подключается файлом pr.asm через INCLUDE (см. его конец).
;
; Контракт подключаемого шрифта: определить ровно две метки —
;   font_chars
;   font8x8

;
; Формат глифа: 8 строк по 8 бит, бит 7 = левый пиксель, строка 0 —
; верхняя. font_chars перечисляет символы в том же порядке, что и глифы
; в font8x8, и заканчивается нулём; индекс глифа = позиция символа.
; Не найденный символ рисуется глифом 0 (пробел).
;
; Свой шрифт: ROM добавляет в SRCS собственный .asm-модуль, объявляющий эти
; метки через PUBLIC, и собирается с -Ca-DFONT_EXTERNAL. Тогда дефолтный файл сюда
; не включается вовсе (pr.asm берёт метки как EXTERN).
;
; ---------------------------------------------------------------
; ВАЖНО:
;
; В исходном коде здесь отсутствовал '$'.
; В font8x8 глифы идут в порядке:
;
;   ...
;   &
;   $
;   #
;   *
;   +
;   %
;
; Поэтому font_chars должен содержать '$'.
; ---------------------------------------------------------------

font_chars:
        defm    " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-:().,?!@<>=&#$*+%;[]_"
        defb    '"'
        defb    0

font8x8:
        defb    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 ; ' '
        defb    0x30, 0x78, 0xCC, 0xCC, 0xFC, 0xCC, 0xCC, 0x00 ; 'A'
        defb    0xFC, 0x66, 0x66, 0x7C, 0x66, 0x66, 0xFC, 0x00 ; 'B'
        defb    0x3C, 0x66, 0xC0, 0xC0, 0xC0, 0x66, 0x3C, 0x00 ; 'C'
        defb    0xF8, 0x6C, 0x66, 0x66, 0x66, 0x6C, 0xF8, 0x00 ; 'D'
