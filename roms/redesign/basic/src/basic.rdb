    {
      "address": "0x0020",
      "comment": "func_rst_cmp_dehl — RST 4 (0x0020): сравнить HL с DE, выставить Z (равенство). Сверка границ строки/окна.",
      "name": "func_rst_cmp_dehl",
      "properties": {
        "calls": "[\"MOV A,H / SBB D / RNZ / ORA L / SBB E / RET\"]",
