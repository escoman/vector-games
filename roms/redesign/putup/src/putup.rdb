      "address": "0x0000",
      "links": [
        "0x0B57"
      ],
      "name": "reset_vector",
      "properties": {
        "interrupt_type": "RESET vector — JMP 0x0B57 (rom_init). Executed on CPU reset/power-on.",
        "vector_target": "0x0B57 (rom_init)"
      },
      "size": 3,
      "type": "data"
    },
    {
      "address": "0x0038",
      "links": [
        "0x03A4"
      ],
      "name": "rst7_vblank_vector",
      "properties": {
        "frequency_hz": "~50.08 Hz (312 lines × 768 × 12 MHz). Source: VECTOR_VERIFIED.md §10.",
        "interrupt_type": "RST 7 (VBlank) — JMP 0x03A4 (isr_handler). ~50 Hz, maskable via EI/DI.",
        "mechanism": "VSDL: inject RST 7 opcode (0xFF) at line 0, pixel 174. EMU80: cpu->intRst(7) when m_intsEnabled.",
        "vector_target": "0x03A4 (isr_handler)"
      },
      "size": 3,
      "type": "data"
    },
    {
      "address": "0x0100",
      "comment": "ROM entry point. DI; JMP 0x0B57 (rom_init)",
      "links": [
        "0x0B57"
      ],
      "name": "rom_entry",
      "properties": {
        "params": "none",
        "returns": "void (JMP to rom_init)"
      },
      "type": "function"
    },
    {
      "address": "0x0145",
      "comment": "Data reading loop. Reads byte from [HL], calls 0x0803 (draw), advances HL. Called 5x from main_logic.",
      "name": "data_read_loop",
      "properties": {
        "params": "A=data_byte, HL=source_ptr (passed through to draw_to_vram)",
        "returns": "void (advances HL, saves to [0x0B53])"
      },
      "type": "function"
    },
    {
      "address": "0x014F",
      "name": "save_hl_ptr",
      "size": 4,
      "type": "function"
    },
    {
      "address": "0x017C",
      "comment": "Decrement with wrap. A = (A-1) mod 8. If A goes negative, wraps to 7. Used for cycling through 8 states. Called from data_process_loop.",
      "links": [
        "0x019B"
      ],
      "name": "dec_mod8",
      "properties": {
        "params": "A=counter_value",
        "returns": "A=(A-1) mod 8, wraps to 7 if negative"
      },
      "type": "function"
    },
    {
      "address": "0x019B",
      "comment": "Called from dec_mod8 (0x017C). Reads data from 0x08D3 area. Used for 8-state cycling logic.",
      "name": "sub_019B",
      "properties": {
        "params": "none (reads data from [0x08D3] via sub_032C)",
        "returns": "A=data_value from table lookup"
      },
      "type": "function"
    },
    {
      "address": "0x01A1",
      "comment": "Keyboard input handler. Scans via IN 01, checks bit 5 (ANI 20). Called 4x.",
      "name": "kbd_input_handler",
      "properties": {
        "params": "none (reads keyboard via IN 01)",
        "returns": "A=keyboard_state (bit 5 tested)"
      },
      "type": "function"
    },
    {
      "address": "0x01AE",
      "comment": "Reads X/Y from 0x08FE/0x08FF, calls sub_1BD4 for address calc, then JMP data_read_loop. Draws at screen coordinates.",
      "links": [
        "0x0145",
        "0x1BD4"
      ],
      "name": "calc_and_draw",
      "properties": {
        "params": "none (reads X from [0x08FE], Y from [0x08FF])",
        "returns": "void (sets up HL via calc_obj_addr, JMPs to data_read_loop)"
      },
      "type": "function"
    },
    {
      "address": "0x0321",
      "comment": "Data dispatch table. PCHL-based dispatch to sub-functions at 0x0439, 0x045E, 0x0483, 0x04A8, 0x04CD. Called from 0x01BC.",
      "links": [
        "0x032C"
      ],
      "name": "data_dispatch",
      "properties": {
        "params": "HL=data_stream_ptr (reads [HL], increments)",
        "returns": "void (loop: reads bytes, calls kbd_input_handler until zero marker)"
      },
      "type": "function"
    },
    {
      "address": "0x032C",
      "comment": "Data reader. Called from data_dispatch (0x0321) and dispatch table (0x01BC). Reads data from [HL] via address table lookup.",
      "name": "sub_032C",
      "properties": {
        "params": "A=index_value, HL=lookup_table_ptr",
        "returns": "A=looked_up_value (16-bit address table lookup with carry math)"
      },
      "type": "function"
    },
    {
      "address": "0x0331",
      "name": "load_de_dispatch",
      "size": 20,
      "type": "function"
    },
    {
      "address": "0x0383",
      "comment": "Interrupt vector setup. Writes JMP 0x03A4 at 0x0038 (RST 7), JMP 0x0B57 at 0x0001. Sets draw_offset=0xE0. OUT 0x10. EI; RET.",
      "links": [
        "0x0000",
        "0x0038"
      ],
      "name": "init_1",
      "properties": {
        "params": "none",
        "returns": "void (sets up RST 7 vector at 0x0038, draw_offset=0xE0, EI)"
      },
      "size": 32,
      "type": "function"
    },
    {
      "address": "0x03A4",
      "comment": "Interrupt Service Routine. Saves regs, handles AY-3-8910 music playback, reads keyboard (IN 02), calls isr_anim_update. Vector at 0x0038 -> JMP 0x03A4.",
      "links": [
        "0x384E",
        "0x090F",
        "0x08D3",
        "0x08C3",
        "0x3858",
        "0x08DF"
      ],
      "name": "isr_handler",
      "properties": {
        "interrupt_source": "RST 7 (VBlank), ~50 Hz, maskable",
        "isr_phases": "1)Save regs 2)Inc frame_counter 3)AY sound update (15 regs) 4)Reset AY mux 5)Kbd scan 8 rows 6)Restore AY reg 7)CALL isr_anim_update 8)EI;RET",
        "params": "none (ISR entry, CPU auto-pushes PC/PSW)",
        "returns": "void (RET from interrupt, restores H/D/B/PSW)"
      },
      "size": 93,
      "type": "function"
    },
    {
      "address": "0x0401",
      "comment": "Graphics data loop. 256 iterations from 0x6000. Calls sub_04CD, then main_logic(0439)/sub_045E/sub_0483/sub_04A8 per position. Processes graphic objects.",
      "links": [
        "0x0483",
        "0x04CD",
        "0x0439",
        "0x04A8",
        "0x045E"
      ],
      "name": "init_2",
      "properties": {
        "params": "none (self-contained init, sets HL=0x6000, DE=0x3041, B=0x00)",
        "returns": "void (preserves all registers via PUSH/POP)"
      },
      "type": "function"
    },
    {
      "address": "0x0439",
      "comment": "Main game/menu logic. 226 bytes. Contains dispatch table and game state processing.",
      "name": "main_logic",
      "properties": {
        "params": "HL=VRAM_buffer_ptr (0x6000 area), DE=data_source_ptr (from stack)",
        "returns": "void (modifies 8 bytes at HL based on bit patterns from DE)"
      },
      "type": "function"
    },
    {
