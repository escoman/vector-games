/*
 * fire2.c — огонь для Вектора-06Ц.
 *
 * Внутренний буфер 64×64 байт (каждый байт — цвет 0–15).
 * Вывод на экран 256×256×16: каждый пиксель буфера увеличивается в 4 раза.
 *
 * Алгоритм огня — как в fire.html:
 *   1. Нижняя строка буфера — случайные «очаги» пламени.
 *   2. Каждая следующая строка: цвет берётся из строки ниже
 *      со случайным горизонтальным сдвигом (−1, 0, +1) и затуханием.
 *
 * Адресация VRAM (256×256, столбцы снизу вверх):
 *   addr = plane_base + col×256 + (255 − row)
 *   Плоскости: 0 → E000, 1 → C000, 2 → A000, 3 → 8000
 *
 * Байт плоскости содержит 8 горизонтальных пикселей (бит 7 = левый).
 * Для масштабирования 4× один байт покрывает 2 столбца и 1 строку
 * из 4×4-блока: биты 7–4 — столбцы 0–1, биты 3–0 — столбцы 2–3.
 * Старший бит nibble = верхняя строка блока, младший = нижняя.
 *
 * Две соседние точки буфера (0xF0 — левый пиксель, 0x0F — правый)
 * при цвете 0x0F (все плоскости) дают 4 строки 0xFF во всех плоскостях.
 */

#include "v06.h"

/* ----------------------------- ПАЛИТРА --------------------------------
 * 16 цветов огня. Формат V06: BB_GGG_RRR.
 * 0 = чёрный (фон), 15 = белое пламя.
 * --------------------------------------------------------------- */

static const unsigned char fire_palette[16] = {
    V06_RGB(0, 0, 0),       /*  0: чёрный (фон)          */
    V06_RGB(1, 0, 0),       /*  1: тёмный дым             */
    V06_RGB(2, 0, 0),       /*  2: бордовый               */
    V06_RGB(3, 0, 0),       /*  3: тёмно-красный          */
    V06_RGB(4, 0, 0),       /*  4: красный                */
    V06_RGB(5, 0, 0),       /*  5: оранжево-красный       */
    V06_RGB(6, 0, 0),       /*  6: тёмно-оранжевый        */
    V06_RGB(7, 0, 0),       /*  7: оранжевый              */
    V06_RGB(7, 1, 0),       /*  8: светло-оранжевый       */
    V06_RGB(7, 2, 0),       /*  9: жёлто-оранжевый        */
    V06_RGB(7, 3, 1),       /* 10: насыщенно-жёлтый       */
    V06_RGB(7, 4, 1),       /* 11: жёлтый                 */
    V06_RGB(7, 5, 2),       /* 12: светло-жёлтый          */
    V06_RGB(7, 6, 2),       /* 13: почти белый            */
    V06_RGB(7, 7, 3),       /* 14: белёсый                */
    V06_RGB(7, 7, 3)        /* 15: белое пламя            */
};

/* ------------------------------ ГСЧ -----------------------------------
 * Предгенерированная таблица случайных чисел (256 байт).
 * --------------------------------------------------------------- */

static unsigned char rnd_table[256];
static unsigned char rnd_idx;

static void rnd_init(void)
{
    unsigned int seed = 0x1234;
    unsigned char i = 0;
    do {
        seed = seed * 251 + 73;
        rnd_table[i] = (unsigned char)(seed >> 8);
    } while (++i != 0);
    rnd_idx = 0;
}

#define rnd_next()  (rnd_table[rnd_idx++])

/* -------------------------- БУФЕР ОГНЯ -------------------------------- */

#define FIRE_W  64
#define FIRE_H  40

/* 2 точки по 4 бита в одном байте */
static unsigned char fire_buf[(FIRE_W * FIRE_H) >> 1];

/* Теневая копия буфера: хранит цвет, фактически записанный в VRAM в прошлом
 * кадре. Позволяет сравнивать в RAM и не трогать VRAM для неизменных блоков.
 * Обновляется лениво (по одному байту) внутри fire_render — без копирования
 * всего буфера. */
static unsigned char prev_buf[(FIRE_W * FIRE_H) >> 1];

/* Индекс байта в буфере для точки (x, y).
 * (y*FIRE_W + x) >> 1 == (y << 5) + (x >> 1), т.к. FIRE_W = 64 —
 * избегаем 16-битного умножения. */
#define FIRE_IDX(x, y)  (((unsigned int)(y) << 5) + ((x) >> 1))

/* Получить цвет точки (x, y), 0..15 (одно чтение памяти):
 * чётный x — старшая тетрада (>>4), нечётный x — младшая (>>0). */
#define get_fire_buf(x, y) \
    ((fire_buf[FIRE_IDX(x, y)] >> (((x) & 1) ? 0 : 4)) & 0x0F)

/* Записать цвет точки (x, y), 0..15 (read-modify-write, индекс один раз). */
#define put_fire_buf(x, y, value) \
    do { \
        unsigned int  _fi = FIRE_IDX(x, y); \
        unsigned char _fc = fire_buf[_fi]; \
        fire_buf[_fi] = ((x) & 1) \
            ? (unsigned char)((_fc & 0xF0) | ((value) & 0x0F)) \
            : (unsigned char)((_fc & 0x0F) | (((value) & 0x0F) << 4)); \
    } while (0)

/* ----------------------- АЛГОРИТМ ОГНЯ -------------------------------
 * Классический алгоритм из fire.html:
 *   1. Верхняя строка (y = 0): случайные очаги — источник огня.
 *   2. Строки y = 1 .. FIRE_H-1: берём пиксель из строки ВЫШЕ (y-1)
 *      со случайным сдвигом x (−1, 0, +1) и корректным переносом, вычитаем
 *      затухание.
 *      В ВЕРХНЕЙ половине экрана (y >= FIRE_H/2, т.е. у верхушек пламени) —
 *      дополнительное затухание (острые вершины).
 *   3. При маппинге y=0 → ofs=0 (низ экрана) огонь растёт снизу вверх.
 * --------------------------------------------------------------- */

static void fire_generate(unsigned char power)
{
    unsigned char x, y;
    unsigned char above, decay;
    signed int sx;

    /* 1. Верхняя строка — «очаги» пламени (источник у основания) */
    for (x = 0; x < FIRE_W; x++) {
        if (rnd_next() < power) {
            put_fire_buf(x, 0, 15);
        } else if (rnd_next() > 128) {
            unsigned char current = get_fire_buf(x, 0);

            put_fire_buf(x, 0,
                (current > 2) ? current - 2 : 0);
        }
    }

    /* 2. Огонь поднимается: от строки 0 к строке FIRE_H-1 */
    for (y = 1; y < FIRE_H; y++) {
        /* Сдвиг индекса ГСЧ на нечётное число между строками.
         * Иначе на строку уходит ровно 128 значений (кратно 256),
         * и строки y / y+2 получают идентичные сдвиги для всех столбцов —
         * вертикальные «каналы» вместо живого пламени (как в fire.html). */
        rnd_idx += 7;

        for (x = 0; x < FIRE_W; x++) {
            /* Случайный сдвиг −1, 0, +1 с корректным переносом по ширине */
            sx = (signed int)x + ((signed int)(rnd_next() % 3) - 1);
            if (sx < 0)            sx += FIRE_W;
            else if (sx >= FIRE_W) sx -= FIRE_W;

            above = get_fire_buf(
                (unsigned char)sx,
                (unsigned char)(y - 1)
            );

            decay = rnd_next() & 1;

            /* Верхняя половина экрана (верхушки пламени) тухнет быстрее */
            if (y >= FIRE_H / 2 && (rnd_next() > 178))
                decay += 1;

            put_fire_buf(
                x,
                y,
                (above > decay) ? above - decay : 0
            );
        }
    }
}

/* ----------------------- РЕНДЕРИНГ НА ЭКРАН --------------------------
 * Каждый пиксель буфера 64×64 → блок 4×4 на экране 256×256.
 *
 * Один байт буфера = пара соседних пикселей (старшая тетрада — левый,
 * младшая — правый) = один блок 4×4. Все 4 строки блока в плоскости
 * одинаковы, поэтому пишутся одним значением 4 раза.
 *
 * Оптимизация «теневой буфер»: сравниваем пару пикселей с прошлым кадром
 * в RAM. Если не изменилась — VRAM не трогаем вообще. Если изменилась —
 * пишем ТОЛЬКО те плоскости, чей бит в паре пикселей отличается от прошлого
 * (обычно цвет меняется на ±1, т.е. одна плоскость). Это же чинит прежнее
 * залипание: когда бит гаснет (bn=0), плоскость перезаписывается нулём.
 *
 * Байт плоскости: биты 7–4 — левый пиксель (0xF0), биты 3–0 — правый (0x0F).
 * byte_val = bn * 0x0F, где bn = (левый_бит<<4) | правый_бит ∈ {0,1,16,17}
 *   → 0x00 / 0x0F / 0xF0 / 0xFF.
 * --------------------------------------------------------------- */

static void fire_render(void)
{
    static const unsigned int plane_bases[4] = {
        0xE000u,  /* плоскость 0 (бит 0) */
        0xC000u,  /* плоскость 1 (бит 1) */
        0xA000u,  /* плоскость 2 (бит 2) */
        0x8000u   /* плоскость 3 (бит 3) */
    };

    unsigned int idx;

    for (idx = 0; idx < (unsigned int)((FIRE_W * FIRE_H) >> 1); idx++) {
        unsigned char cur  = fire_buf[idx];
        unsigned char prev = prev_buf[idx];
        unsigned char cl, cr, ocl, ocr, p;
        unsigned int block_addr;

        if (cur == prev)
            continue;           /* блок не менялся — VRAM не трогаем */

        prev_buf[idx] = cur;    /* ленивое обновление тени (1 байт) */

        cl  = (unsigned char)(cur  >> 4);   /* новая пара: левый / правый */
        cr  = (unsigned char)(cur  & 0x0F);
        ocl = (unsigned char)(prev >> 4);   /* старая пара (что на экране) */
        ocr = (unsigned char)(prev & 0x0F);

        /* idx = fy*32 + col;  col = idx & 31, fy = idx >> 5.
         * block_addr = col*256 + fy*4 (y=0 — низ экрана). */
        block_addr = ((unsigned int)(idx & 31) << 8)
                   + ((unsigned int)((idx >> 5) << 2));

        for (p = 0; p < 4; p++) {
            unsigned char bn = (unsigned char)(
                (((cl  >> p) & 1) << 4) | ((cr  >> p) & 1));
            unsigned char bo = (unsigned char)(
                (((ocl >> p) & 1) << 4) | ((ocr >> p) & 1));
            unsigned char *dst;
            unsigned char byte_val;

            if (bn == bo)
                continue;       /* эта плоскость не изменилась */

            byte_val = (unsigned char)(bn * 0x0F);
            dst = (unsigned char *)(plane_bases[p] + block_addr);
            dst[0] = byte_val;
            dst[1] = byte_val;
            dst[2] = byte_val;
            dst[3] = byte_val;
        }
    }
}

/* ----------------------------- MAIN ---------------------------------- */

int main(void)
{
    unsigned int i;

    /* Инициализация: чёрный экран, палитра огня */
    gfx_set_black_palette();
    gfx_clear(0);
    gfx_set_bmp_palette(fire_palette);

    /* Экран очищен, поэтому буфер и его теневая копия должны быть нулевыми
     * (BSS при --no-crt автоматически не обнуляется). */
    for (i = 0; i < (unsigned int)((FIRE_W * FIRE_H) >> 1); i++) {
        fire_buf[i] = 0;
        prev_buf[i] = 0;
    }

    rnd_init();

    /* Основной цикл: генерация + отрисовка кадра огня (50 Гц) */
    for (;;) {
        gfx_next_frame();

        fire_generate(153);   /* ~60% очагов, как в fire.html (rand > 0.40) */
        fire_render();
    }

    return 0;
}
