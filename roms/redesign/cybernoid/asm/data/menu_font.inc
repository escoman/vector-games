; Cybernoid menu font glyphs (8x8 mono, 8 bytes/glyph)
; Codes: 0x26..0x59
; Base address: 0x2700
; Indexing: offset = base + (code - 0x24) * 8
; Format: 1 byte/row, MSB=left, row 0=top
;

data_menu_font:
    ; char 0x26 ('&')
    defb 0x00, 0x08, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00

    ; char 0x27 (''')
    defb 0x00, 0x1C, 0x10, 0x10, 0x10, 0x10, 0x1C, 0x00

    ; char 0x28 ('(')
    defb 0x00, 0x38, 0x08, 0x08, 0x08, 0x08, 0x38, 0x00

    ; char 0x29 (')')
