# Порождаемые данные (перегенерируются make'ом из исходников в assets/):
#   include/title.inc       — tools/gen_title.py из assets/hate.png;
#   include/title_music.asm — tools/gen_title_music.py из assets/title_music.txt;
#   include/font.asm        — tools/gen_font.py из assets/font_6300.bin;
#   include/terrain.inc     — tools/gen_terrain.py из assets/ring_8000.bin
#                             и assets/terrain_mask.bin (окно $D5B2);
#   include/levels.inc      — tools/gen_levels.py из assets/level_data.bin
#                             (байт-коды карт уровней, этап 4–6).
include/title.inc
include/title_music.asm
include/font.asm
include/terrain.inc
include/levels.inc
