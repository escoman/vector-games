      "size": 2,
      "type": "variable"
    },
    {
      "address": "0x0100",
      "comment": "ROM entry: DI; JMP 0x0B57 (decompressed main init)",
      "links": [
        "0x0B57"
      ],
      "name": "func_rom_entry",
      "size": 4,
      "type": "function"
    },
    {
      "address": "0x010C",
      "comment": "Read 16-bit from [HL] into DE, advance HL+2. Then call func_render_block x4 for data loading. IN: HL=ptr. OUT: DE=value, HL+=2. Clobbers: A,DE,HL.",
      "name": "func_read_16bit_de",
      "properties": {
        "clobbers": "A,DE,HL",
        "input": "HL=ptr to 16-bit data",
        "output": "DE=16-bit value; HL+=2"
      },
      "size": 16,
      "type": "function"
    },
    {
      "address": "0x0121",
      "comment": "Sound init: 4x dispatch with hardcoded params, clears VRAM. IN: none. OUT: none. Clobbers: A,E. Saves: D,PSW.",
      "links": [
        "0x0EF7",
        "0x01BC"
      ],
      "name": "func_sound_init",
      "type": "function"
    },
    {
      "address": "0x0145",
      "comment": "Data loader 2: CALL 0x0800, INX H, SHLD 0x0B53. Simpler data loading.",
      "name": "func_data_loader2",
      "properties": {
        "clobbers": "A,HL",
        "input": "HL=ptr; A=data byte",
        "output": "HL+=1; [0x0B53] updated"
      },
      "type": "function"
    },
    {
      "address": "0x014F",
      "comment": "Store HL to data stream pointer at 0x0B53. SHLD 0B53; RET.",
      "name": "func_store_data_ptr",
      "properties": {
        "input": "HL=value to store",
        "output": "[0x0B53]=HL"
      },
      "size": 4,
      "type": "function"
    },
    {
      "address": "0x0153",
      "comment": "Piece type lookup: uses timer upper nibble as index into 9-byte table at 0x016C. IN: A=piece type (1-7). OUT: A=variant (0-7). Clobbers: A,D,E,HL.",
      "links": [
        "0x0197"
      ],
      "name": "func_piece_type_lookup",
      "properties": {
        "clobbers": "A,D,E,HL",
        "input": "A=piece type (1-7)",
        "output": "A=variant (0-7)"
      },
      "type": "function"
    },
    {
      "address": "0x017C",
      "comment": "Keyboard scan + frame timer. IN: A=frame counter (decremented), L=compare value. OUT: A=result (0=key pressed), Z flag. Clobbers: A,flags. Side effect: IN 0x01 every 7 frames.",
      "links": [
        "0x08D3"
      ],
      "name": "func_keyboard_timer",
      "properties": {
        "clobbers": "A,flags",
        "input": "A=frame counter; L=compare value",
        "output": "A=result; Z flag"
      },
      "size": 30,
      "type": "function"
    },
    {
      "address": "0x0197",
      "links": [
        "0x08D3",
        "0x032C"
      ],
      "name": "func_read_timer_data",
      "size": 10,
      "type": "function"
    },
    {
      "address": "0x01A1",
      "comment": "Data loader: reads ptr from [0x0B53], calls 0x0800, increments ptr",
      "links": [
        "0x0800",
        "0x0B53"
      ],
      "name": "func_data_loader",
      "properties": {
        "clobbers": "A,HL",
        "input": "A=data byte",
        "output": "HL+=1; [0x0B53] updated"
      },
      "size": 13,
      "type": "function"
    },
    {
      "address": "0x01AE",
      "comment": "Set stream position from vars 0x08FE/0x08FF. Reads 16-bit via 0x1BD4, stores to 0x0B53.",
      "name": "func_set_stream_pos",
      "size": 12,
      "type": "function"
    },
    {
      "address": "0x01BC",
      "comment": "Jump table dispatcher. IN: A=index (ANI 0F, 0-15), E=param, B=compare. OUT: depends on index (PCHL). Clobbers: A,HL,D. Saves: H,D,PSW.",
      "links": [
        "0x01CD"
      ],
      "name": "func_jmp_table_dispatch",
      "properties": {
        "clobbers": "A,HL,D",
        "input": "A=index (ANI 0F); E=param; B=compare",
        "output": "PCHL (depends on index)"
      },
      "size": 24,
      "type": "function"
    },
    {
      "address": "0x01CD",
      "comment": "Jump table: 16 entries x 2 bytes. Entries 0-11: sound params + write. Entries 12-15: mul7 calc.",
      "name": "data_jmp_table",
      "size": 32,
      "type": "table"
    },
    {
      "address": "0x0201",
      "comment": "Sound/timer write: read 16-bit from 0x031A, mul7, OUT 0x0B",
      "links": [
        "0x031A",
        "0x020E"
      ],
      "name": "func_sound_timer_write",
      "size": 13,
      "type": "function"
    },
    {
      "address": "0x020E",
      "comment": "Multiply [HL] 16-bit value by 12 via DAD chain. IN: HL=ptr to 16-bit value. OUT: HL=value*12. Clobbers: HL,DE. Note: actually x12, not x7.",
      "name": "func_mul7",
      "properties": {
        "clobbers": "HL,DE",
        "input": "HL=ptr to 16-bit value",
        "output": "HL=value*12"
      },
      "size": 11,
      "type": "function"
    },
    {
      "address": "0x026A",
      "name": "lbl_dispatch_return",
      "type": "label"
    },
    {
      "address": "0x031A",
      "comment": "Sound/timer parameter table: 12 bytes (0x031A-0x0325). Written by jump table dispatcher, read by func_sound_timer_write.",
      "name": "var_sound_params",
      "size": 12,
      "type": "variable"
    },
    {
      "address": "0x0321",
      "name": "func_text_render",
      "size": 9,
      "type": "function"
    },
    {
      "address": "0x032C",
      "comment": "Table lookup: XRA B, MOV L,A; RNC/INR H for carry. Index calculations.",
      "name": "func_table_lookup",
      "properties": {
        "clobbers": "A,HL,carry",
        "input": "HL=table base; A=index; B=0",
        "output": "HL=HL+A (element addr)"
      },
      "size": 20,
      "type": "function"
    },
    {
      "address": "0x0351",
      "comment": "Read 16-bit from [HL] into DE. Alternative entry point (same as func_read_16bit_de).",
      "name": "func_read_16bit_v2",
      "properties": {
        "clobbers": "DE,HL",
        "input": "HL=ptr to 16-bit data",
        "output": "DE=16-bit value; HL+=2"
      },
      "size": 4,
      "type": "function"
    },
    {
      "address": "0x0355",
      "comment": "16-bit division via repeated subtraction. Computes HL/DE with remainder. Used for coordinate calculations.",
      "name": "func_calc_vram_offset",
      "properties": {
        "clobbers": "A,C,DE,HL",
        "input": "HL=dividend; DE=divisor",
        "output": "A=quotient; DE=remainder"
      },
      "size": 15,
      "type": "function"
    },
    {
      "address": "0x0383",
      "comment": "ROM init: PIA port 0x10, timer vars, ISR vector at 0x0038, JMP 0x0B57 at 0x0000, EI",
      "links": [
        "0x0038",
        "0x03A4"
      ],
      "name": "func_rom_init",
      "size": 33,
      "type": "function"
    },
    {
      "address": "0x03A4",
      "comment": "ISR handler (RST 7, VBlank ~50Hz). 3 phases: 1) Frame counter [0x08DF]++ and palette animation (16 colors from [0x08DB] to port 0x0C with scroll animation on port 0x03). 2) PIA setup (0x8A→port 0x00, 0x88→port 0x00), keyboard scan via IN 0x02 with scroll values. 3) Post-ISR: scroll [0x08CF]→port 0x03, border [0x08C4]→port 0x02, CALL func_isr_game_state. Saves/restores H,D,B,PSW. Ends with EI;RET.",
      "links": [
        "0x08CD",
        "0x08C3",
        "0x08DB",
        "0x3858"
      ],
      "name": "func_isr",
      "properties": {
        "clobbers": "A,C,D,E (saves H,D,B,PSW)",
        "input": "none (hardware interrupt RST 7)",
        "output": "palette/scroll/border via ports; game state update"
      },
      "type": "function"
    },
    {
      "address": "0x0400",
      "comment": "Startup decompression. IN: none (hardcoded src=0x2761, dst=0x6000). OUT: none. 256 iterations x 4 bitplane unpackers x 8 bytes = 8192 bytes decompressed. Clobbers: all regs (saves H,D,B,PSW).",
      "links": [
        "0x045E",
        "0x04CD",
        "0x0439",
        "0x04A8",
        "0x0483"
      ],
      "name": "func_decompress",
      "type": "function"
    },
    {
      "address": "0x0439",
      "comment": "Bitplane 0 decompressor. IN: DE=source (decrementing), HL=dest (incrementing). OUT: DE-=8, HL+=8. Extracts bits 7 and 3 from each source byte. Clobbers: A,B,C,DE,HL.",
      "name": "func_decomp_plane0",
      "properties": {
        "clobbers": "A,B,C,DE,HL",
        "input": "DE=source (decrementing); HL=dest (incrementing)",
        "output": "DE-=8; HL+=8; bits 7,3 extracted"
      },
      "type": "function"
    },
    {
      "address": "0x045E",
      "comment": "Bitplane 1 decompressor. IN: DE=source, HL=dest. OUT: DE-=8, HL+=8. Extracts bits 6 and 2. Clobbers: A,B,C,DE,HL.",
      "name": "func_decomp_plane1",
      "properties": {
        "clobbers": "A,B,C,DE,HL",
        "input": "DE=source; HL=dest",
        "output": "DE-=8; HL+=8; bits 6,2 extracted"
      },
      "type": "function"
    },
    {
      "address": "0x0483",
      "comment": "Bitplane 2 decompressor. IN: DE=source, HL=dest. OUT: DE-=8, HL+=8. Extracts bits 5 and 1. Clobbers: A,B,C,DE,HL.",
      "name": "func_decomp_plane2",
      "properties": {
        "clobbers": "A,B,C,DE,HL",
        "input": "DE=source; HL=dest",
        "output": "DE-=8; HL+=8; bits 5,1 extracted"
      },
      "type": "function"
    },
    {
      "address": "0x04A8",
      "comment": "Bitplane 3 decompressor. IN: DE=source, HL=dest. OUT: DE-=8, HL+=8. Extracts bits 4 and 0. Clobbers: A,B,C,DE,HL.",
      "name": "func_decomp_plane3",
      "properties": {
        "clobbers": "A,B,C,DE,HL",
        "input": "DE=source; HL=dest",
        "output": "DE-=8; HL+=8; bits 4,0 extracted"
      },
      "type": "function"
    },
    {
      "address": "0x04CD",
      "comment": "Data transpose/copy. IN: none (hardcoded HL=0x2761, BC=0x6000). OUT: BC=updated dest, HL=updated source. 4 blocks x 8 bytes. Clobbers: A,BC,DE,HL.",
      "name": "func_decomp_transpose",
      "type": "function"
    },
    {
      "address": "0x0600",
      "name": "data_glyph_table_lo",
      "size": 256,
      "type": "table"
    },
    {
      "address": "0x0700",
      "name": "data_glyph_table_hi",
      "size": 256,
      "type": "table"
    },
    {
      "address": "0x0800",
      "comment": "VRAM block copy. IN: A=data byte, HL=logical screen addr, BC=offset. OUT: 16 bytes written to VRAM. Uses SP-swap trick (save SP to 0x08DD). DI/EI. Two entry points: 0x0800 (ORA A;RZ check) and 0x0803 (main code). Clobbers: all regs.",
      "name": "func_copy_to_vram",
      "properties": {
        "clobbers": "A,B,C,D,E,H,L",
        "input": "A=data byte; HL=screen addr; BC=offset",
        "output": "16 bytes written to VRAM"
      },
      "size": 163,
      "type": "function"
    },
    {
      "address": "0x0803",
      "comment": "Render block to VRAM. IN: A=data, HL=screen addr, BC=offset. OUT: block rendered. Calls func_copy_to_vram. Saves: PSW,B,D,H. Clobbers: all regs.",
      "links": [
        "0x0800",
        "0x08DD"
      ],
      "name": "func_render_block",
      "properties": {
        "clobbers": "all (saves PSW,B,D,H)",
        "input": "A=data; HL=screen addr; BC=offset",
        "output": "block rendered in VRAM"
      },
      "type": "function"
    },
    {
      "address": "0x08C3",
      "comment": "Animation enable flag. When [0x08C3]!=0, palette animation runs in ISR. Decremented each ISR frame. Controls timing of palette cycling.",
      "name": "var_frame_counter",
      "size": 1,
      "type": "variable"
    },
    {
      "address": "0x08C4",
      "comment": "Border color value. Read from [0x08C4] and written to port 0x02 in ISR post-animation phase. Controls screen border color.",
      "name": "var_border_color",
      "size": 1,
      "type": "variable"
    },
    {
      "address": "0x08CD",
      "comment": "ISR data pointer for palette animation. Points to 16-byte color data in ROM. Advanced during palette cycling (DCX H).",
      "name": "var_frame_count_isr",
      "size": 1,
      "type": "variable"
    },
    {
      "address": "0x08CF",
      "comment": "VRAM scroll value. Read from [0x08CF] and written to port 0x03 in ISR post-animation. Controls screen vertical scroll.",
