      "name": "sub_04CD",
      "properties": {
        "params": "none (loads HL=0x2761, BC=0x6000 internally)",
        "returns": "void (copies 8-byte blocks from ROM to VRAM 0x6000)"
      },
      "type": "function"
    },
    {
      "address": "0x0800",
      "comment": "Expand byte to VRAM. Params: A=data_byte (8 pixels), HL=encoded_vram_addr. Expands 1 byte into 8 identical vertical rows in VRAM using stack ops (SPHL/POP D). HL+0xB000 = VRAM base. Decodes X (bits 0-4) and Y (bits 3-5 of H) from HL. Preserves/restores SP via saved_sp_08DD. 163 bytes.",
      "name": "draw_to_vram",
      "properties": {
        "calling_convention": "register-based: A=data_byte, HL=encoded_vram_addr",
        "description": "Expands single byte A into 8 identical vertical pixel rows in VRAM. HL encodes VRAM destination address. Uses stack manipulation (SPHL, POP D, MOV M,E/D, INX H) for fast 8-row write. Preserves/restores SP via saved_sp_08DD.",
        "param_A": "data_byte - 8 pixels to expand vertically into 8 rows",
        "param_HL": "encoded VRAM address from calc_obj_addr (E*32 + D*256 + 0x5000)",
        "returns": "void - writes 8 bytes to VRAM via stack operations"
      },
      "type": "function"
    },
