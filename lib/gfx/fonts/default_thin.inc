;
; default_thin.inc — шрифт тонкий 4x8 по умолчанию для Вектора-06Ц.
;
; Подключается файлом pr512t.asm через INCLUDE (см. его конец).
;
; Контракт подключаемого шрифта: определить ровно две метки —
;   font_chars_512t
;   font_thin

;
; Формат глифа: 8 байт, старшая тетрада — чётные пиксели, младшая —
; нечётные. Индекс глифа = позиция в font_chars_512t, множитель 8.
;
; Свой шрифт: ROM добавляет в SRCS собственный .asm-модуль, объявляющий эти
; метки через PUBLIC, и собирается с -Ca-DFONT_EXTERNAL_512T. Тогда дефолтный файл сюда
; не включается вовсе (pr512t.asm берёт метки как EXTERN).
;
; ---------------------------------------------------------------
; Символы шрифта.
; ---------------------------------------------------------------
font_chars_512t:
        defm    " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-:().,?!@<>=&$#*+%;[]_"
        defb    '"'
        defb    0

; ---------------------------------------------------------------
; font_thin: 56 глифов по 8 байт.
; Старшая тетрада = чётные пиксели, младшая = нечётные.
