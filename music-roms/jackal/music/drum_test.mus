; drum_test.mus — только ударные, каждые 8 тиков (= 1/4 ноты при PPQ=32)
; Цель: проверить, правильно ли playback engine играет drum timing
Tempo: T225
sample 0: samples/kick.smp
sample 1: samples/snare.smp
drums:
L8 0 L8 1 L8 0 L8 1 L8 0 L8 1 L8 0 L8 1
L8 0 L8 1 L8 0 L8 1 L8 0 L8 1 L8 0 L8 1
L8 0 L8 1 L8 0 L8 1 L8 0 L8 1 L8 0 L8 1
L8 0 L8 1 L8 0 L8 1 L8 0 L8 1 L8 0 L8 1
