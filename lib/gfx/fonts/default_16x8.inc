;
; default_16x8.inc — шрифт 16x8 (512x256) по умолчанию для Вектора-06Ц.
;
; Подключается файлом pr512.asm через INCLUDE (см. его конец).
;
; Контракт подключаемого шрифта: определить ровно две метки —
;   font_chars_512
;   font16x8

;
; Формат глифа: 16 байт = 8 строк по паре (чётный/нечётный пиксель
; режима 512x256), каждый символ продублирован по байтам. Индекс глифа
; = позиция в font_chars_512, множитель 16.
;
; Свой шрифт: ROM добавляет в SRCS собственный .asm-модуль, объявляющий эти
; метки через PUBLIC, и собирается с -Ca-DFONT_EXTERNAL_512. Тогда дефолтный файл сюда
; не включается вовсе (pr512.asm берёт метки как EXTERN).
;
; ---------------------------------------------------------------
; Таблица символов
; ---------------------------------------------------------------

font_chars_512:
        defm    " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-:().,?!@<>=&$#*+%;[]_"
        defb    '"'
        defb    0


; ---------------------------------------------------------------
; font16x8
